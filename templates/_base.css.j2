/* 两页共用：配色、字体、基础排版。设计规格见 design/issue/DESIGN.md */
/* 字体自托管子集（scripts/fetch_font.py），国内也能稳定加载：标题 ZCOOL XiaoWei，数字与读数 Geist Mono，均为 OFL */
@font-face{font-family:"Radar Heading";src:url("{{ root }}assets/fonts/heading.woff2") format("woff2");font-weight:400;font-display:swap}
@font-face{font-family:"Radar Mono";src:url("{{ root }}assets/fonts/mono.woff2") format("woff2");font-weight:400 500;font-display:swap}
:root{
  --bg:#f5f7f8;--raise:#e9edef;--line:rgba(20,30,38,.12);--line-2:rgba(20,30,38,.28);
  --ink:#15202a;--ink-2:#45525e;--muted:#5f6b77;--on:#fff;
  --signal:#a85400;--signal-dot:#d97706;--dot:#8b98a4;--scope:rgba(21,32,42,.5);
  --up:#1d7348;--warn:#8a4b00;--warn-wash:#fbf1e0;--warn-line:#d98a1c;
  --heading:"Radar Heading","Noto Serif SC","Source Han Serif SC","Songti SC",STSong,serif;
  --sans:system-ui,-apple-system,"Segoe UI","PingFang SC","Microsoft YaHei","Noto Sans SC",sans-serif;
  --mono:"Radar Mono",ui-monospace,SFMono-Regular,Consolas,"Liberation Mono",monospace;
  --ease:cubic-bezier(.22,1,.36,1);
  color-scheme:light;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0e1216;--raise:#1a2026;--line:rgba(225,235,242,.12);--line-2:rgba(225,235,242,.3);
  --ink:#e6ebef;--ink-2:#a9b4bd;--muted:#8d99a4;--on:#0e1216;
  --signal:#f5a524;--signal-dot:#f5a524;--dot:#5d6a75;--scope:rgba(245,165,36,.5);
  --up:#6fd09f;--warn:#e0a85c;--warn-wash:#2a2115;--warn-line:#b8832e;color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0e1216;--raise:#1a2026;--line:rgba(225,235,242,.12);--line-2:rgba(225,235,242,.3);
  --ink:#e6ebef;--ink-2:#a9b4bd;--muted:#8d99a4;--on:#0e1216;
  --signal:#f5a524;--signal-dot:#f5a524;--dot:#5d6a75;--scope:rgba(245,165,36,.5);
  --up:#6fd09f;--warn:#e0a85c;--warn-wash:#2a2115;--warn-line:#b8832e;color-scheme:dark}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.7 var(--sans);-webkit-font-smoothing:antialiased}
.wrap{max-width:1200px;margin:0 auto;padding-left:max(24px,env(safe-area-inset-left,0px));padding-right:max(24px,env(safe-area-inset-right,0px))}
/* 正文链接带细下划线，颜色不是唯一区分（WCAG 1.4.1） */
a{color:inherit;text-decoration:underline;text-decoration-thickness:1px;text-decoration-color:var(--line-2);text-underline-offset:4px;transition:text-decoration-color 140ms var(--ease),color 140ms var(--ease)}
a:hover{text-decoration-color:currentColor}
:focus-visible{outline:2px solid var(--signal);outline-offset:2px;border-radius:4px}
h1,h2{font-family:var(--heading);font-weight:400;margin:0;text-wrap:balance}
h2{font-size:28px;line-height:1.3}
h3{font-size:15px;font-weight:600;margin:0}
p,ol,ul{margin:0}
.num,.mono{font-variant-numeric:tabular-nums}
.mono{font-family:var(--mono)}
.muted{color:var(--muted)}
.ic{width:1.25em;height:1.25em;vertical-align:-.25em;flex:none}
.av{width:24px;height:24px;border-radius:6px;vertical-align:-6px;margin-right:8px;background:var(--raise);display:inline-block;object-fit:cover}
.top{display:flex;flex-wrap:wrap;gap:4px 20px;align-items:center;justify-content:space-between;padding-block:16px;border-bottom:1px solid var(--line);font-size:13px;color:var(--ink-2)}
.top nav{display:flex;flex-wrap:wrap;gap:4px 16px}
.top nav a{text-decoration:none}
.top nav a:hover,.top nav a[aria-current]{color:var(--ink)}
.top nav a.go{color:var(--signal)}
.top b{font-weight:600;color:var(--ink);font-size:14px}
.top b a{text-decoration:none}
footer{border-top:1px solid var(--line);padding-block:32px 48px;font-size:13px;color:var(--muted);display:grid;gap:8px}
footer code{font:12px var(--mono);overflow-wrap:anywhere}
@media (max-width:640px){
  .wrap{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
}
@media print{.top nav,canvas{display:none!important}a{color:var(--ink)}}
